FROM ubuntu:22.04

LABEL description="Alignment image with pinned tools: bwa=0.7.17, samtools=1.17, htslib=1.17, gatk=4.3.0.0 (installed via Miniforge)"

ENV DEBIAN_FRONTEND=noninteractive \
    MINIFORGE_DIR=/opt/miniforge \
    PATH=/opt/miniforge/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      wget \
      bzip2 \
      ca-certificates \
      openjdk-17-jre \
      build-essential && \
    rm -rf /var/lib/apt/lists/*

# Install Miniforge (conda-forge's lightweight conda)
RUN wget -qO /tmp/miniforge.sh https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh && \
    bash /tmp/miniforge.sh -b -p ${MINIFORGE_DIR} && \
    rm /tmp/miniforge.sh && \
    ${MINIFORGE_DIR}/bin/conda init bash || true

# Install mamba and pinned bioinformatics packages from conda-forge/bioconda
RUN ${MINIFORGE_DIR}/bin/conda install -y -c conda-forge mamba && \
    ${MINIFORGE_DIR}/bin/mamba install -y -c conda-forge -c bioconda \
      bwa=0.7.17 \
      samtools=1.17 \
      htslib=1.17 \
      gatk=4.3.0.0 && \
    ${MINIFORGE_DIR}/bin/conda clean -afy

WORKDIR /data

CMD ["bash"]
